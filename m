    kernel/trace/ftrace.c:  kallsyms_lookup(rec->ip, NULL, NULL, NULL, st=
r);
    kernel/trace/ftrace.c:  kallsyms_lookup((unsigned long)rec->ops->func=
, NULL, NULL, NULL, str);
    kernel/trace/ftrace.c:  kallsyms_lookup(rec->ip, NULL, NULL, NULL, st=
