    Samsung SoC Framebuffer driver: add Alpha Channel support
   =20
    Add support for the ARGB1888 and ARGB4888 hardware to the Samsung SoC
    Framebuffer driver (s3c-fb.c).
   =20
    ARGB1888 and ARGB4888 is decided by var->transp.length and this varia=
ble
    is set by s3c_fb_check_var().
   =20
    In s3c_fb_check_var(), if var->vits_per_pixel is 25 or 28, then
    var->transp.length would be 1 or 3.
   =20
    Therefore alpha mode(ARGB1888 or ARGB4888) could be decided through t=
hat
    variable.
   =20
    For using alpha mode, you need to set the following: This code should=
 be
    added to your machine code as platform data.
   =20
    static struct s3c_fb_pd_win xxx_fb_win0 =3D {
    	/* this is to ensure we use win0 */
    	.win_mode =3D {
    		.pixclock		=3D (8+8+8+240)*(38+4+38+400),
    		.left_margin	=3D 8,
    		.right_margin	=3D 8,
    		.upper_margin	=3D 38,
    		.lower_margin	=3D 38,
    		.hsync_len		=3D 8,
    		.vsync_len		=3D 4,
    		.xres			=3D 240,
    		.yres			=3D 400,
    	},
    	.max_bpp		=3D 32,
    	.default_bpp	=3D 24,
    };
   =20
    static struct s3c_fb_pd_win xxx_fb_win1 =3D {
    	.win_mode =3D {
    		.pixclock		=3D (8+8+8+240)*(38+4+38+400),
    		.left_margin	=3D 8,
    		.right_margin	=3D 8,
    		.upper_margin	=3D 38,
    		.lower_margin	=3D 38,
    		.hsync_len		=3D 8,
    		.vsync_len		=3D 4,
    		.xres			=3D 240,
    		.yres			=3D 400,
    	},
    	.max_bpp		=3D 32,
    	.default_bpp	=3D 28,
    };
   =20
    static struct s3c_fb_platdata xxx_lcd_pdata __initdata =3D {
    	.win[0]		=3D &ncp_fb_win0,
    	.win[1]		=3D &ncp_fb_win1,
    	.vidcon0	=3D VIDCON0_VIDOUT_RGB | VIDCON0_PNRMODE_RGB,
    	.vidcon1	=3D VIDCON1_INV_HSYNC | VIDCON1_INV_VSYNC,
    	.setup_gpio	=3D xxx_fb_gpio_setup,
    };
   =20
    s3c_fb_set_platdata(&xxx_lcd_pdata);
   =20
    The above code sets pixelformat for window0 layer to RGB888 and windo=
w1
    layer to ARGB4888.
   =20
