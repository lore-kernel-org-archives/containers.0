5 231059
    ---------------------------------------------------------------------=
---------
   =20
    ---------------------------------------------------------------------=
-----
    commit c69d48540c201394d08cb4d48b905e001313d9b8
    Author: Jens Axboe <jens.axboe-QHcLZuEGTsvQT0dZR+AlfA@public.gmane.org>
    Date:   Fri Apr 24 08:12:19 2009 +0200
   =20
        block: include discard requests in IO accounting
   =20
        We currently don't do merging on discard requests, but we potenti=
ally
        could. If we do, then we need to include discard requests in the =
IO
        accounting, or merging would end up decrementing in_flight IO cou=
nters
        for an IO which never incremented them.
   =20
        So enable accounting for discard requests.
   =20
    <snip>
   =20
     static inline int blk_do_io_stat(struct request *rq)
     {
    -       return rq->rq_disk && blk_rq_io_stat(rq) && blk_fs_request(rq=
);
    +       return rq->rq_disk && blk_rq_io_stat(rq) && blk_fs_request(rq=
) &&
    +               blk_discard_rq(rq);
     }
    ---------------------------------------------------------------------=
-----
   =20
