    IMA: iint put in ima_counts_get and put
   =20
    ima_counts_get() calls ima_iint_find_insert_get() which takes a refer=
ence
    to the iint in question, but does not put that reference at the end o=
f the
    function.  This can lead to a nasty memory leak.  Easy enough to repr=
oduce:
   =20
    #include <sys/mman.h>
    #include <stdio.h>
   =20
    int main (void)
    {
    	int i;
    	void *ptr;
   =20
    	for (i=3D0; i < 100000; i++) {
    		ptr =3D mmap(NULL, 4096, PROT_READ|PROT_WRITE,
    			   MAP_SHARED|MAP_ANONYMOUS, -1, 0);
    		if (ptr =3D=3D MAP_FAILED)
    			return 2;
    		munmap(ptr, 4096);
    	}
   =20
    	return 0;
    }
   =20
