    // <smpl>
    @@
    struct device *dev;
    expression E;
    type T;
    @@
   =20
    - dev->driver_data =3D (T)E
    + dev_set_drvdata(dev, E)
   =20
    @@
    struct device *dev;
    type T;
    @@
   =20
    - (T)dev->driver_data
    + dev_get_drvdata(dev)
    // </smpl>
